  "code": {
    "framework": "react",
    "package": "@carbon/react",
    "component": "TextInput",
    "import": "import { TextInput } from '@carbon/react';",
    "required": [
      "id"
    ],
    "alwaysEmit": [
      "size"
    ],
    "alwaysEmitWhy": "A TextInput without size inherits the nearest <Layout size>; emit size explicitly so the snippet matches the variant."
  },
  "notes": [
    {
      "level": "verify",
      "at": "anatomy.Warn icon",
      "message": "WarningAltFilled is two-tone: _text-input.scss L115 paints its inner path (path:first-of-type) $black-100 while the outer path takes $support-warning. Icons are one flattened Vector (#13), so the Design Library shows a support-warning triangle with the mark cut out instead of a black mark. Its key exists only in svg/32 at @carbon/icons 11.90.0, so it resolves through the fallback."
    },
    {
      "level": "info",
      "at": "anatomy.Invalid text",
      "message": "useNormalizedInputProps.tsx L79-L99 renders invalidText when invalid and warnText when warn, in the same .cds--form-requirement, and TextInput.tsx L429 drops helperText for either. The Contract keeps one TEXT node and one property per message, shown by `visible` rules (#93), so each property names one code prop."
    },
    {
      "level": "info",
      "at": "layout.Box.paddingLeft",
      "message": "Padding is layout.density('padding-inline') at the default density 'normal' (_text-input.scss L37, L42), which is $spacing-05 (16px). Density has no DTCG token."
    },
    {
      "level": "info",
      "at": "layout.Box.gap",
      "message": "With an icon, _text-input.scss L171 sets padding-inline-end: $spacing-08 (40px) and L107 places the 16px icon at inset-inline-end $spacing-05. The Box models that as the icon in flow: $spacing-03 gap + 16px icon + $spacing-05 padding = 40px."
    },
    {
      "level": "info",
      "at": "layout.Field.strokeWeight",
      "message": "Carbon draws the focus and invalid outline on the input (_text-input.scss L69-L73, L241-L245) with outline-offset: -2px, so it covers the bottom border. The Contract puts the stroke on Field, which holds both Box and Underline, so it covers both in Figma too. Invalid and focused shows the focus outline: .cds--text-input:focus outranks .cds--text-input--invalid, and _form.scss L116-L117 applies the invalid outline only :not(:focus)."
    },
    {
      "level": "info",
      "at": "paint[state=focus]",
      "message": "Carbon styles :focus and :active the same (_text-input.scss L69-L73, focus-outline('outline')); Active is folded into Focus. Carbon has no hover style for the field."
    },
    {
      "level": "info",
      "at": "family",
      "message": "Left out of this draft: inline (labels beside the field), enableCounter/maxCount, hideLabel, the decorator/AI label slot, the deprecated light prop, the v12 border-radius and gradient border behind enable-v12-release, and the Fluid and Password variants."
    }
  ],
