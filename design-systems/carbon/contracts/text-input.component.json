  "anatomy": {
    "name": "Text input",
    "type": "COMPONENT",
    "children": [
      { "name": "Label", "type": "TEXT", "role": "label" },
      {
        "name": "Field group",
        "type": "FRAME",
        "children": [
          {
            "name": "Field",
            "type": "FRAME",
            "role": "input",
            "children": [
              {
                "name": "Box",
                "type": "FRAME",
                "children": [
                  { "name": "Value", "type": "TEXT", "role": "value" },
                  { "name": "Invalid icon", "type": "INSTANCE", "role": "icon", "instanceOf": "icon:warning--filled" },
                  { "name": "Warn icon", "type": "INSTANCE", "role": "icon", "instanceOf": "icon:warning--alt--filled" }
                ]
              },
              { "name": "Underline", "type": "FRAME" }
            ]
          },
          { "name": "Helper", "type": "TEXT", "role": "helper-text" },
          { "name": "Invalid text", "type": "TEXT", "role": "validation-message" },
          { "name": "Warn text", "type": "TEXT", "role": "validation-message" }
        ]
      }
    ]
  },

  "properties": [
    { "key": "label", "label": "Label", "type": "TEXT", "default": "Label", "binds": [ { "node": "Label", "field": "characters" } ], "code": { "prop": "labelText" } },
    { "key": "placeholder", "label": "Placeholder", "type": "TEXT", "default": "Placeholder text", "binds": [ { "node": "Value", "field": "characters" } ], "code": { "prop": "placeholder" } },
    { "key": "helperText", "label": "Helper text", "type": "TEXT", "default": "Helper text", "binds": [ { "node": "Helper", "field": "characters" } ], "code": { "prop": "helperText" } },
    { "key": "invalidText", "label": "Invalid text", "type": "TEXT", "default": "Error message", "binds": [ { "node": "Invalid text", "field": "characters" } ], "code": { "prop": "invalidText" } },
    { "key": "warnText", "label": "Warn text", "type": "TEXT", "default": "Warning message", "binds": [ { "node": "Warn text", "field": "characters" } ], "code": { "prop": "warnText" } }
  ],

  "layout": [
    {
      "match": {},
      "set": {
        "Text input": {
          "direction": "column",
          "width": "fill",
          "height": "hug",
          "alignMain": "start",
          "alignCross": "start",
          "paddingTop": { "raw": 0, "level": "info", "reason": "the form item has no padding" },
          "paddingRight": { "raw": 0, "level": "info", "reason": "the form item has no padding" },
          "paddingBottom": { "raw": 0, "level": "info", "reason": "the form item has no padding" },
          "paddingLeft": { "raw": 0, "level": "info", "reason": "the form item has no padding" },
          "gap": { "token": "spacing-03" }
        },
        "Label": { "textStyle": { "token": "label-01" }, "textResize": "width-and-height" },
        "Field group": { "direction": "column", "width": "fill", "height": "hug", "gap": { "token": "spacing-02" } },
        "Field": { "direction": "column", "width": "fill", "height": "hug", "strokeWeight": { "raw": 2, "level": "warning", "reason": "outline: 2px with outline-offset: -2px (focus-outline mixin); no design token" }, "strokeAlign": "inside", "gap": { "raw": 0, "level": "info", "reason": "the underline is the input's bottom border, flush with the box" } },
        "Box": {
          "direction": "row",
          "width": "fill",
          "alignCross": "center",
          "paddingLeft": { "token": "spacing-05" },
          "paddingRight": { "token": "spacing-05" },
          "gap": { "token": "spacing-03" }
        },
        "Value": { "textStyle": { "token": "body-compact-01" }, "width": "fill", "textResize": "height" },
        "Invalid icon": { "width": { "token": "icon-size-01" }, "height": { "token": "icon-size-01" }, "visible": false },
        "Warn icon": { "width": { "token": "icon-size-01" }, "height": { "token": "icon-size-01" }, "visible": false },
        "Underline": { "width": "fill", "height": { "raw": 1, "level": "warning", "reason": "border-block-end: 1px is a constant with no design token" } },
        "Helper": { "textStyle": { "token": "helper-text-01" }, "width": "fill", "textResize": "height", "visible": true },
        "Invalid text": { "textStyle": { "token": "helper-text-01" }, "width": "fill", "textResize": "height", "visible": false },
        "Warn text": { "textStyle": { "token": "helper-text-01" }, "width": "fill", "textResize": "height", "visible": false }
      }
    },
    { "match": { "validation": "invalid" }, "set": { "Invalid icon": { "visible": true }, "Invalid text": { "visible": true }, "Helper": { "visible": false } } },
    { "match": { "validation": "warn" }, "set": { "Warn icon": { "visible": true }, "Warn text": { "visible": true }, "Helper": { "visible": false } } },
    { "match": { "size": "xs" }, "set": { "Box": { "height": { "raw": 23, "level": "info", "reason": "derived: size-xs (24) − 1px bottom border (box-sizing: border-box)" } } } },
    { "match": { "size": "sm" }, "set": { "Box": { "height": { "raw": 31, "level": "info", "reason": "derived: size-sm (32) − 1px bottom border" } } } },
    { "match": { "size": "md" }, "set": { "Box": { "height": { "raw": 39, "level": "info", "reason": "derived: size-md (40) − 1px bottom border" } } } },
    { "match": { "size": "lg" }, "set": { "Box": { "height": { "raw": 47, "level": "info", "reason": "derived: size-lg (48) − 1px bottom border" } } } }
  ],

  "paint": [
    {
      "match": {},
      "set": {
        "Text input": { "fill": "none", "stroke": "none" },
        "Label": { "fill": { "token": "text-secondary" } },
        "Field": { "fill": { "token": "field-01" }, "stroke": "none" },
        "Value": { "fill": { "token": "text-placeholder" } },
        "Invalid icon/Vector": { "fill": { "token": "support-error" } },
        "Warn icon/Vector": { "fill": { "token": "support-warning" } },
        "Underline": { "fill": { "token": "border-strong-01" } },
        "Helper": { "fill": { "token": "text-helper" } },
        "Invalid text": { "fill": { "token": "text-error" } },
        "Warn text": { "fill": { "token": "text-primary" } }
      }
    },
    {
      "match": { "validation": "invalid" },
      "set": { "Field": { "stroke": { "token": "support-error" } } }
    },
    {
      "match": { "readOnly": "read-only" },
      "set": { "Field": { "fill": "none" }, "Underline": { "fill": { "token": "border-subtle-00" } } }
    },
    {
      "match": { "state": "focus" },
      "set": { "Field": { "stroke": { "token": "focus" } } }
    },
    {
      "match": { "state": "disabled" },
      "set": {
        "Label": { "fill": { "token": "text-disabled" } },
        "Value": { "fill": { "token": "text-disabled" } },
        "Helper": { "fill": { "token": "text-disabled" } }
      }
    }
  ],

  "icons": {
