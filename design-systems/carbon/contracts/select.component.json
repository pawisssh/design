  "code": {
    "framework": "react",
    "package": "@carbon/react",
    "component": "Select",
    "import": "import { Select, SelectItem } from '@carbon/react';",
    "required": [
      "id"
    ],
    "items": {
      "component": "SelectItem",
      "props": [
        "value",
        "text"
