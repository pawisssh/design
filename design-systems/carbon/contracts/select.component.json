    "alwaysEmitWhy": "A Select without size inherits the nearest <Layout size>; emit size explicitly so the snippet matches the variant."
  },
  "notes": [
    {
      "level": "verify",
      "at": "anatomy.Warn icon",
      "message": "WarningAltFilled is two-tone: _select.scss L204-L207 paints its inner path (path[fill]) $black-100 while the outer path takes $support-warning. Icons are one flattened Vector (#13), so the Design Library shows a support-warning triangle with the mark cut out instead of a black mark. Its key exists only in svg/32 at @carbon/icons 11.90.0, so it resolves through the fallback."
    },
    {
      "level": "info",
      "at": "anatomy.Invalid text",
      "message": "useNormalizedInputProps.tsx L79-L99 renders invalidText when invalid and warnText when warn, in the same .cds--form-requirement, and Select.tsx L369 drops helper for either; helper holds helperText (Select.tsx L242-L250). The Contract keeps one TEXT node and one property per message, shown by `visible` rules (#93), so each property names one code prop."
    },
    {
      "level": "info",
      "at": "properties.value",
      "message": "The Value text is the selected SelectItem's text (SelectItem.tsx L40 and L61). The options are children the feature supplies (code.items, ADR 0013); the Contract shows one, and a Handoff's Usage lists them."
    },
    {
      "level": "info",
      "at": "layout.Box.gap",
      "message": "Carbon positions the chevron at inset-inline-end $spacing-05 (_select.scss L170) and the status icon at $spacing-08 (L185), both absolutely, and reserves room with padding-inline: $spacing-05 $spacing-09, whose end is $spacing-09 (L67), or $spacing-10 with a status icon (L141-L144). In Auto Layout that is right padding $spacing-05 plus a $spacing-05 gap before the 16px chevron, closing to $spacing-03 when the status icon shows."
    },
    {
      "level": "info",
      "at": "layout.Field.strokeWeight",
      "message": "Carbon draws the focus and invalid outline on the select (_select.scss L121-L125 focus-outline('outline'); _form.scss L120-L126 focus-outline('invalid') only :not(:focus)) with outline-offset: -2px, so it covers the bottom border. The Contract puts the stroke on Field, which holds both Box and Underline. Invalid and focused shows the focus outline."
    },
    {
      "level": "info",
      "at": "paint[readOnly=read-only]",
      "message": "Read-only keeps a transparent field on hover: .cds--select--readonly .cds--select-input (_select.scss L297-L305) sets background after the :hover rule (L87) at equal specificity."
    },
    {
      "level": "info",
      "at": "paint[state=disabled]",
      "message": "_select.scss L127-L133 styles :disabled and :hover:disabled the same, with a transparent bottom border, so the Underline has no fill; L136-L139 greys the label and helper text."
    },
    {
      "level": "info",
      "at": "family",
      "message": "Left out of this draft: inline (labels beside the field), hideLabel/noLabel, the decorator/AI label slot, the deprecated light prop, SelectItemGroup, the v12 border-radius and gradient border behind enable-v12-release, and the Fluid variant."
    }
  ],
