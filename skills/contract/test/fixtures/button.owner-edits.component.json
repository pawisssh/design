  "anatomy": {
    "name": "Button",
    "type": "COMPONENT",
    "children": [
      {
        "name": "Label",
        "type": "TEXT",
        "role": "label"
      },
      {
        "name": "Icon",
        "type": "FRAME",
        "role": "icon-slot",
        "children": [
          {
            "name": "Glyph",
            "type": "INSTANCE",
            "role": "icon",
            "instanceOf": "icon:default"
          }
        ]
      }
    ]
  },
  "properties": [
    {
      "key": "label",
      "label": "Label",
      "type": "TEXT",
      "default": "Button",
      "binds": [
        {
          "node": "Label",
          "field": "characters"
        }
      ],
      "code": {
        "prop": "children"
      }
    },
    {
      "key": "icon",
      "label": "Icon",
      "type": "BOOLEAN",
      "default": false,
      "binds": [
        {
          "match": {
            "kind": [
              "primary",
              "secondary",
              "tertiary",
              "danger",
              "danger--tertiary"
            ]
          },
          "node": "Glyph",
          "field": "visible",
          "why": "Carbon reserves the 64px end padding with or without an icon, so the Icon slot stays and only the glyph hides."
        },
        {
          "match": {
            "kind": [
              "ghost",
              "danger--ghost"
            ]
          },
          "node": "Icon",
          "field": "visible",
          "why": "Ghost kinds place the icon in flow; without an icon the button is narrower, so the whole slot hides."
        }
      ],
      "code": {
        "prop": "renderIcon",
        "whenFalse": "omit"
      }
    },
    {
      "key": "swapIcon",
      "label": "Swap icon",
      "type": "INSTANCE_SWAP",
      "default": "icon:default",
      "preferred": "icon:preferred",
      "binds": [
        {
          "node": "Glyph",
          "field": "mainComponent"
        }
      ],
      "code": {
        "prop": "renderIcon",
        "valueFrom": "icon",
        "visibleWhen": "icon"
      }
    }
  ],
