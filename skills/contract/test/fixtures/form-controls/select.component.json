        { "key": "sm", "label": "Small",       "code": { "size": "sm" } },
        { "key": "md", "label": "Medium",      "code": { "size": "md" } },
        { "key": "lg", "label": "Large",       "code": { "size": "lg" } }
      ]
    },
    {
