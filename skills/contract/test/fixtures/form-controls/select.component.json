  "code": {
    "framework": "react",
    "package": "@carbon/react",
    "component": "Select",
    "import": "import { Select, SelectItem } from '@carbon/react';",
    "required": ["id"],
    "items": { "component": "SelectItem", "props": ["value", "text"] },
    "alwaysEmit": ["size"],
    "alwaysEmitWhy": "A Select without size inherits the nearest <Layout size>; emit size explicitly so the snippet matches the variant."
  },

  "notes": [
    { "level": "verify", "at": "anatomy.Warn icon", "message": "WarningAltFilled is two-tone: _select.scss paints its inner path (path[fill]) $black-100 while the outer path takes $support-warning. Icons are one flattened Vector (#13), so the Design Library shows a support-warning triangle with the mark cut out instead of a black mark." },
    { "level": "info", "at": "properties.value", "message": "The Value text is the selected SelectItem's text. The options are children the feature supplies (code.items, #93); the Contract shows one, and the Handoff lists them." },
    { "level": "info", "at": "layout.Box.gap", "message": "Carbon positions the chevron (inset-inline-end spacing-05) and the status icon (inset-inline-end spacing-08) absolutely and reserves room with padding-inline-end spacing-09, or spacing-10 with a status icon. In Auto Layout that is right padding spacing-05 plus a spacing-05 gap, closing to spacing-03 when the status icon shows." },
    { "level": "info", "at": "paint[readOnly=read-only]", "message": "Read-only keeps a transparent field on hover: .cds--select--readonly .cds--select-input sets background after the :hover rule at equal specificity." },
    { "level": "info", "at": "paint.Field.fill", "message": "Carbon's $field, $field-hover, $border-strong and $border-subtle are contextual Layer tokens. At :root and .cds--layer-one they resolve to field-01, field-hover-01, border-strong-01 and border-subtle-00, which the Contract binds. Inside <Layer level={1|2}> they shift to -02/-03; the Contract does not model Layer." },
    { "level": "info", "at": "family", "message": "Left out of this draft: inline, hideLabel/noLabel, the decorator/AI label slot, the deprecated light prop, SelectItemGroup, the v12 border-radius and gradient border behind enable-v12-release, and the Fluid variant." }
  ]
}
