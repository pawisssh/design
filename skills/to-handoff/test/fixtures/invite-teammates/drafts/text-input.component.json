  "code": {
    "framework": "react",
    "package": "@carbon/react",
    "component": "TextInput",
    "import": "import { TextInput } from '@carbon/react';",
    "required": [
      "id"
    ],
    "alwaysEmit": [
      "size"
    ],
    "alwaysEmitWhy": "A TextInput without size inherits the nearest <Layout size>; emit size explicitly so the snippet matches the variant."
  },
  "notes": [
    {
      "level": "verify",
      "at": "anatomy.Warn icon",
      "message": "WarningAltFilled is two-tone: _text-input.scss paints its inner path (path:first-of-type, fill=\"none\" in the SVG) $black-100 while the outer path takes $support-warning. Icons are one flattened Vector (#13), so the Design Library shows a support-warning triangle with the mark cut out instead of a black mark."
    },
    {
      "level": "info",
      "at": "anatomy.Invalid text",
      "message": "Carbon renders invalidText when invalid and warnText when warn, in the same .cds--form-requirement, and drops helperText for either. The Contract keeps one TEXT node and one property per message, shown by `visible` rules (#93), so each property names one code prop."
    },
    {
      "level": "info",
      "at": "layout.Box.paddingLeft",
      "message": "Padding is layout.density('padding-inline') at the default density 'normal', which is $spacing-05 (16px). Density has no DTCG token."
    },
    {
      "level": "info",
      "at": "paint[state=focus]",
      "message": "Carbon styles :focus and :active the same (focus-outline('outline')); Active is folded into Focus. Carbon has no hover style for the field."
    },
    {
      "level": "info",
      "at": "family",
      "message": "Left out of this draft: inline (labels beside the field), enableCounter/maxCount, hideLabel, the decorator/AI label slot, the deprecated light prop, the v12 border-radius and gradient border behind enable-v12-release, and the Fluid and Password variants."
    }
  ],
