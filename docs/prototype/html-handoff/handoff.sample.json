    "proposals": { "avatar-stack": "sha256:(not computed in the prototype)" },
    "modes": { "light": "white" },
    "notes": [
      { "level": "info", "text": "Single-mode Prototype: matched in White only. Matched tokens carry Gray 10, Gray 90 and Gray 100 too, so a dark theme comes free but is unverified." }
    ],
    "ignored": []
  },
  "screens": [
