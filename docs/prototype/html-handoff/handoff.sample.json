    { "id": "q-success-kind", "kind": "off-axis", "text": "Copy invite link is green, but Carbon Button has no success kind. Use primary, secondary or another kind?" },
    { "id": "q-breakpoint", "kind": "breakpoint", "text": "The Prototype stacks the actions below 640px; Carbon's md starts at 672px. Stack below md?" },
