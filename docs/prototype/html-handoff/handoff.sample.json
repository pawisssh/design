{
  "$comment": "PROTOTYPE for #63. A sample Handoff (#56 + amendments from #60, #61, #62) for the sample Prototype. Style entries carry `raw` plus the `expect`ed tier; build.mjs runs a stand-in matcher (#61 rules) over them, checks each lands in the expected tier, and writes the matched Handoff to out/handoff.json. `interactions` is left out on purpose so the Rendering's 'Not specified' display is exercised.",
  "schemaVersion": 1,
  "revision": 1,
  "feature": {
    "name": "Invite teammates",
    "owner": "Workspace admin flows",
    "status": "draft",
    "goal": "A workspace admin invites people by email and sees who is still pending.",
    "scope": ["Invite one email at a time with a role", "See and remove pending invites", "See seats used"],
    "nonGoals": ["Billing for extra seats", "Accepting an invite (the invitee's side)"]
  },
  "source": {
    "input": "prototype",
    "ref": "docs/prototype/html-handoff/sample-prototype/index.html",
    "kind": "html-file",
    "designSystem": "carbon",
