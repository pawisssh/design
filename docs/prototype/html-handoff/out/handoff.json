  "openQuestions": [
    {
      "id": "q-font",
      "kind": "font",
      "text": "The Prototype uses Inter. Use the Design System's font-family-sans (IBM Plex Sans)?"
    },
    {
      "id": "q-error-state",
      "kind": "missing-state",
      "text": "What happens when sending fails? The Prototype's simulated send never fails, so the error state has no branch."
    },
    {
      "id": "q-no-contract",
      "kind": "no-contract",
      "text": "The email input, the role select and the toast have no Contract in this Design System. Carbon has TextInput, Select and ToastNotification. Read them with the Adapter before building?"
    },
    {
      "id": "q-success-kind",
      "kind": "off-axis",
      "text": "Copy invite link is green, but Carbon Button has no success kind. Use primary, secondary or another kind?"
    },
    {
      "id": "q-breakpoint",
      "kind": "breakpoint",
      "text": "The Prototype stacks the actions below 640px; Carbon's md starts at 672px. Stack below md?"
    },
    {
      "id": "q-invites-source",
      "kind": "stand-in",
      "text": "Where do pending invites really come from (endpoint, paging)?"
    }
  ]
